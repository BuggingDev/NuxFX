From 10f61185efaf2287f7a8212a148d9ced27ef1c36 Mon Sep 17 00:00:00 2001
From: aegnux-contributor <contributor@example.invalid>
Date: Sun, 18 Oct 2026 05:04:54 +0300
Subject: [PATCH 02/16] dzn: release meta objects exactly once on device
 creation failure

dzn_meta_blits_finish() and the indirect draw and triangle fan finish helpers
released their objects without clearing the pointers. dzn_meta_init() also
called dzn_meta_finish() on failure, and dzn_device_create() then called
dzn_device_destroy(), which finishes the meta state again. A device creation
that failed inside dzn_meta_init() therefore freed the blit hash tables twice
and corrupted the heap.

Clear the pointers when they are released, and make dzn_device_destroy() the
single owner of the meta cleanup.
---
 src/microsoft/vulkan/dzn_meta.c | 27 +++++++++++++++------------
 1 file changed, 15 insertions(+), 12 deletions(-)

diff --git a/src/microsoft/vulkan/dzn_meta.c b/src/microsoft/vulkan/dzn_meta.c
index a9f1761..dd9c832 100644
--- a/src/microsoft/vulkan/dzn_meta.c
+++ b/src/microsoft/vulkan/dzn_meta.c
@@ -106,9 +106,11 @@ dzn_meta_indirect_draw_finish(struct dzn_device *device, struct dzn_indirect_dra
 
    if (meta->root_sig)
       ID3D12RootSignature_Release(meta->root_sig);
+   meta->root_sig = NULL;
 
    if (meta->pipeline_state)
       ID3D12PipelineState_Release(meta->pipeline_state);
+   meta->pipeline_state = NULL;
 }
 
 static VkResult
@@ -241,10 +243,13 @@ dzn_meta_triangle_fan_rewrite_index_finish(struct dzn_device *device,
 
    if (meta->root_sig)
       ID3D12RootSignature_Release(meta->root_sig);
+   meta->root_sig = NULL;
    if (meta->pipeline_state)
       ID3D12PipelineState_Release(meta->pipeline_state);
+   meta->pipeline_state = NULL;
    if (meta->cmd_sig)
       ID3D12CommandSignature_Release(meta->cmd_sig);
+   meta->cmd_sig = NULL;
 }
 
 static VkResult
@@ -755,17 +760,20 @@ dzn_meta_blits_finish(struct dzn_device *device)
    struct dzn_meta_blits *meta = &device->blits;
 
    vk_free(&device->vk.alloc, (void *)meta->vs.pShaderBytecode);
+   meta->vs.pShaderBytecode = NULL;
 
    if (meta->fs) {
       hash_table_foreach(meta->fs, he)
          vk_free(&device->vk.alloc, he->data);
       _mesa_hash_table_destroy(meta->fs, NULL);
+      meta->fs = NULL;
    }
 
    if (meta->contexts) {
       hash_table_foreach(meta->contexts->table, he)
          dzn_meta_blit_destroy(device, he->data);
       _mesa_hash_table_u64_destroy(meta->contexts);
+      meta->contexts = NULL;
    }
 
    mtx_destroy(&meta->shaders_lock);
@@ -782,17 +790,15 @@ dzn_meta_blits_init(struct dzn_device *device)
    mtx_init(&meta->shaders_lock, mtx_plain);
    mtx_init(&meta->contexts_lock, mtx_plain);
 
+   /* Failures are cleaned up by dzn_device_destroy() through dzn_meta_finish(),
+    * which is the only place that releases these objects. */
    meta->fs = _mesa_hash_table_create_u32_keys(NULL);
-   if (!meta->fs) {
-      dzn_meta_blits_finish(device);
+   if (!meta->fs)
       return vk_error(instance, VK_ERROR_OUT_OF_HOST_MEMORY);
-   }
 
    meta->contexts = _mesa_hash_table_u64_create(NULL);
-   if (!meta->contexts) {
-      dzn_meta_blits_finish(device);
+   if (!meta->contexts)
       return vk_error(instance, VK_ERROR_OUT_OF_HOST_MEMORY);
-   }
 
    return VK_SUCCESS;
 }
@@ -841,10 +847,7 @@ dzn_meta_init(struct dzn_device *device)
    }
 
 out:
-   if (result != VK_SUCCESS) {
-      dzn_meta_finish(device);
-      return result;
-   }
-
-   return VK_SUCCESS;
+   /* On failure the caller destroys the device, which calls dzn_meta_finish()
+    * exactly once. Calling it here as well released the meta objects twice. */
+   return result;
 }
