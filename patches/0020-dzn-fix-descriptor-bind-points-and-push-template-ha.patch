From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: NuxFX contributors
Date: Tue, 20 Oct 2026 08:35:00 +0300
Subject: [PATCH] dzn: fix descriptor bind points and push-descriptor entrypoints

vkCmdBindDescriptorSets2KHR and vkCmdPushDescriptorSet2KHR picked exactly one
bind point: compute when stageFlags contained VK_SHADER_STAGE_COMPUTE_BIT and
graphics otherwise. A set used by graphics and compute in the same command
buffer was therefore recorded into only one of them. Update every bind point
that stageFlags selects.

vkCmdPushDescriptorSetWithTemplate2KHR always pushed into the graphics bind
point, although the template stores its own pipelineBindPoint (the command has
no stage flags). Store the bind point in the template and use it. Accept
VK_DESCRIPTOR_UPDATE_TEMPLATE_TYPE_PUSH_DESCRIPTORS_KHR templates, which have
no descriptor set layout; take the layout from the pipeline layout and set
index instead.

Patch 07 implemented only the maintenance6 (2KHR) entrypoints. vkd3d-proton
calls vkCmdPushDescriptorSetKHR, which still resolved to a no-op stub. Add the
non-2 KHR wrappers. The core 1.4 names are not exposed while dzn reports 1.3.

Push constants: return instead of dereferencing a NULL pipeline if they are
uploaded before any pipeline bind. GetDeviceImageMemoryRequirements: pass the
plane aspect through as VkImagePlaneMemoryRequirementsInfo when it is set.

Do not advertise vulkanMemoryModelAvailabilityVisibilityChains: dzn does not
implement chained availability/visibility operations.
---
diff --git a/src/microsoft/vulkan/dzn_cmd_buffer.c b/src/microsoft/vulkan/dzn_cmd_buffer.c
index cbc6e5e..736b468 100644
--- a/src/microsoft/vulkan/dzn_cmd_buffer.c
+++ b/src/microsoft/vulkan/dzn_cmd_buffer.c
@@ -3531,6 +3531,8 @@ dzn_cmd_buffer_update_push_constants(struct dzn_cmd_buffer *cmdbuf, uint32_t bin
       return;
 
    const struct dzn_pipeline *pipeline = cmdbuf->state.pipeline;
+   if (!pipeline)
+      return;
    uint32_t slot = pipeline->root.push_constant_cbv_param_idx;
    if (slot == UINT32_MAX)
       return;
@@ -6158,21 +6160,43 @@ dzn_CmdDrawIndirectByteCountEXT(VkCommandBuffer commandBuffer,
  * the v2 entrypoints to the driver and resolves them to a no-op stub when the
  * driver does not provide them, so dzn has to implement both. Without these,
  * descriptor set and push constant updates were silently dropped. */
+/* Map VkBindDescriptorSetsInfo::stageFlags to the bind points whose state has
+ * to be updated. A set can be used by graphics and compute in the same command
+ * buffer, so stageFlags can require both. A stageFlags value with no graphics
+ * and no compute bit is invalid; keep the old graphics default for robustness. */
+static void
+dzn_bindpoints_for_stages(VkShaderStageFlags stage_flags,
+                          VkPipelineBindPoint *bindpoints, uint32_t *count)
+{
+   *count = 0;
+   if (stage_flags & (VK_SHADER_STAGE_ALL_GRAPHICS |
+                      VK_SHADER_STAGE_TASK_BIT_EXT |
+                      VK_SHADER_STAGE_MESH_BIT_EXT))
+      bindpoints[(*count)++] = VK_PIPELINE_BIND_POINT_GRAPHICS;
+   if (stage_flags & VK_SHADER_STAGE_COMPUTE_BIT)
+      bindpoints[(*count)++] = VK_PIPELINE_BIND_POINT_COMPUTE;
+   if (*count == 0)
+      bindpoints[(*count)++] = VK_PIPELINE_BIND_POINT_GRAPHICS;
+}
+
 VKAPI_ATTR void VKAPI_CALL
 dzn_CmdBindDescriptorSets2KHR(VkCommandBuffer commandBuffer,
                               const VkBindDescriptorSetsInfo *pBindDescriptorSetsInfo)
 {
-   VkPipelineBindPoint bindpoint =
-      (pBindDescriptorSetsInfo->stageFlags & VK_SHADER_STAGE_COMPUTE_BIT) ?
-      VK_PIPELINE_BIND_POINT_COMPUTE : VK_PIPELINE_BIND_POINT_GRAPHICS;
+   VkPipelineBindPoint bindpoints[2];
+   uint32_t bindpoint_count;
 
-   dzn_CmdBindDescriptorSets(commandBuffer, bindpoint,
-                             pBindDescriptorSetsInfo->layout,
-                             pBindDescriptorSetsInfo->firstSet,
-                             pBindDescriptorSetsInfo->descriptorSetCount,
-                             pBindDescriptorSetsInfo->pDescriptorSets,
-                             pBindDescriptorSetsInfo->dynamicOffsetCount,
-                             pBindDescriptorSetsInfo->pDynamicOffsets);
+   dzn_bindpoints_for_stages(pBindDescriptorSetsInfo->stageFlags,
+                             bindpoints, &bindpoint_count);
+   for (uint32_t i = 0; i < bindpoint_count; i++) {
+      dzn_CmdBindDescriptorSets(commandBuffer, bindpoints[i],
+                                pBindDescriptorSetsInfo->layout,
+                                pBindDescriptorSetsInfo->firstSet,
+                                pBindDescriptorSetsInfo->descriptorSetCount,
+                                pBindDescriptorSetsInfo->pDescriptorSets,
+                                pBindDescriptorSetsInfo->dynamicOffsetCount,
+                                pBindDescriptorSetsInfo->pDynamicOffsets);
+   }
 }
 
 VKAPI_ATTR void VKAPI_CALL
@@ -6306,18 +6330,50 @@ dzn_cmd_buffer_push_descriptors(struct dzn_cmd_buffer *cmdbuf,
       DZN_CMD_BINDPOINT_DIRTY_DYNAMIC_BUFFERS;
 }
 
+VKAPI_ATTR void VKAPI_CALL
+dzn_CmdPushDescriptorSetKHR(VkCommandBuffer commandBuffer,
+                            VkPipelineBindPoint pipelineBindPoint,
+                            VkPipelineLayout layout,
+                            uint32_t set,
+                            uint32_t descriptorWriteCount,
+                            const VkWriteDescriptorSet *pDescriptorWrites)
+{
+   VK_FROM_HANDLE(dzn_cmd_buffer, cmdbuf, commandBuffer);
+
+   dzn_cmd_buffer_push_descriptors(cmdbuf, pipelineBindPoint, layout, set,
+                                   descriptorWriteCount, pDescriptorWrites,
+                                   VK_NULL_HANDLE, NULL);
+}
+
 VKAPI_ATTR void VKAPI_CALL
 dzn_CmdPushDescriptorSet2KHR(VkCommandBuffer commandBuffer,
                              const VkPushDescriptorSetInfoKHR *pInfo)
 {
    VK_FROM_HANDLE(dzn_cmd_buffer, cmdbuf, commandBuffer);
-   VkPipelineBindPoint bindpoint =
-      (pInfo->stageFlags & VK_SHADER_STAGE_COMPUTE_BIT) ?
-      VK_PIPELINE_BIND_POINT_COMPUTE : VK_PIPELINE_BIND_POINT_GRAPHICS;
+   VkPipelineBindPoint bindpoints[2];
+   uint32_t bindpoint_count;
+
+   dzn_bindpoints_for_stages(pInfo->stageFlags, bindpoints, &bindpoint_count);
+   for (uint32_t i = 0; i < bindpoint_count; i++) {
+      dzn_cmd_buffer_push_descriptors(cmdbuf, bindpoints[i], pInfo->layout,
+                                      pInfo->set, pInfo->descriptorWriteCount,
+                                      pInfo->pDescriptorWrites, VK_NULL_HANDLE, NULL);
+   }
+}
+
+VKAPI_ATTR void VKAPI_CALL
+dzn_CmdPushDescriptorSetWithTemplateKHR(VkCommandBuffer commandBuffer,
+                                        VkDescriptorUpdateTemplate descriptorUpdateTemplate,
+                                        VkPipelineLayout layout,
+                                        uint32_t set,
+                                        const void *pData)
+{
+   VK_FROM_HANDLE(dzn_cmd_buffer, cmdbuf, commandBuffer);
+   VK_FROM_HANDLE(dzn_descriptor_update_template, templ, descriptorUpdateTemplate);
 
-   dzn_cmd_buffer_push_descriptors(cmdbuf, bindpoint, pInfo->layout, pInfo->set,
-                                   pInfo->descriptorWriteCount,
-                                   pInfo->pDescriptorWrites, VK_NULL_HANDLE, NULL);
+   dzn_cmd_buffer_push_descriptors(cmdbuf, templ->pipelineBindPoint,
+                                   layout, set, 0, NULL,
+                                   descriptorUpdateTemplate, pData);
 }
 
 VKAPI_ATTR void VKAPI_CALL
@@ -6325,8 +6381,10 @@ dzn_CmdPushDescriptorSetWithTemplate2KHR(VkCommandBuffer commandBuffer,
                                          const VkPushDescriptorSetWithTemplateInfoKHR *pInfo)
 {
    VK_FROM_HANDLE(dzn_cmd_buffer, cmdbuf, commandBuffer);
+   VK_FROM_HANDLE(dzn_descriptor_update_template, templ,
+                  pInfo->descriptorUpdateTemplate);
 
-   dzn_cmd_buffer_push_descriptors(cmdbuf, VK_PIPELINE_BIND_POINT_GRAPHICS,
+   dzn_cmd_buffer_push_descriptors(cmdbuf, templ->pipelineBindPoint,
                                    pInfo->layout, pInfo->set, 0, NULL,
                                    pInfo->descriptorUpdateTemplate, pInfo->pData);
 }
diff --git a/src/microsoft/vulkan/dzn_descriptor_set.c b/src/microsoft/vulkan/dzn_descriptor_set.c
index 7f06ab5..61cdf20 100644
--- a/src/microsoft/vulkan/dzn_descriptor_set.c
+++ b/src/microsoft/vulkan/dzn_descriptor_set.c
@@ -2369,9 +2369,24 @@ dzn_descriptor_update_template_create(struct dzn_device *device,
                                       const VkAllocationCallbacks *alloc,
                                       VkDescriptorUpdateTemplate *out)
 {
-   assert(info->templateType == VK_DESCRIPTOR_UPDATE_TEMPLATE_TYPE_DESCRIPTOR_SET);
+   assert(info->templateType == VK_DESCRIPTOR_UPDATE_TEMPLATE_TYPE_DESCRIPTOR_SET ||
+          info->templateType == VK_DESCRIPTOR_UPDATE_TEMPLATE_TYPE_PUSH_DESCRIPTORS_KHR);
 
-   VK_FROM_HANDLE(dzn_descriptor_set_layout, set_layout, info->descriptorSetLayout);
+   /* A push-descriptor template has no descriptorSetLayout; its layout comes
+    * from the pipeline layout and the set index. */
+   struct dzn_descriptor_set_layout *set_layout = NULL;
+   if (info->templateType == VK_DESCRIPTOR_UPDATE_TEMPLATE_TYPE_PUSH_DESCRIPTORS_KHR) {
+      VK_FROM_HANDLE(dzn_pipeline_layout, playout, info->pipelineLayout);
+
+      if (!playout || info->set >= MAX_SETS || !playout->vk.set_layouts[info->set])
+         return vk_error(device, VK_ERROR_UNKNOWN);
+
+      set_layout = container_of(playout->vk.set_layouts[info->set],
+                                struct dzn_descriptor_set_layout, vk);
+   } else {
+      VK_FROM_HANDLE(dzn_descriptor_set_layout, layout, info->descriptorSetLayout);
+      set_layout = layout;
+   }
 
    uint32_t entry_count = 0;
    for (uint32_t e = 0; e < info->descriptorUpdateEntryCount; e++) {
@@ -2404,6 +2419,7 @@ dzn_descriptor_update_template_create(struct dzn_device *device,
       return vk_error(device, VK_ERROR_OUT_OF_HOST_MEMORY);
 
    vk_object_base_init(&device->vk, &templ->base, VK_OBJECT_TYPE_DESCRIPTOR_UPDATE_TEMPLATE);
+   templ->pipelineBindPoint = info->pipelineBindPoint;
    templ->entry_count = entry_count;
    templ->entries = entries;
 
diff --git a/src/microsoft/vulkan/dzn_device.c b/src/microsoft/vulkan/dzn_device.c
index 85ba27c..0b00936 100644
--- a/src/microsoft/vulkan/dzn_device.c
+++ b/src/microsoft/vulkan/dzn_device.c
@@ -860,7 +860,7 @@ dzn_physical_device_get_features(const struct dzn_physical_device *pdev,
       .bufferDeviceAddressMultiDevice     = false,
       .vulkanMemoryModel                  = true,
       .vulkanMemoryModelDeviceScope       = true,
-      .vulkanMemoryModelAvailabilityVisibilityChains = true,
+      .vulkanMemoryModelAvailabilityVisibilityChains = false,
       .shaderOutputViewportIndex          = false,
       .shaderOutputLayer                  = false,
       .subgroupBroadcastDynamicId         = true,
diff --git a/src/microsoft/vulkan/dzn_image.c b/src/microsoft/vulkan/dzn_image.c
index 1e2b604..124d217 100644
--- a/src/microsoft/vulkan/dzn_image.c
+++ b/src/microsoft/vulkan/dzn_image.c
@@ -939,9 +939,14 @@ dzn_GetDeviceImageMemoryRequirements(VkDevice dev,
       return;
    }
 
+   const VkImagePlaneMemoryRequirementsInfo plane_info = {
+      .sType = VK_STRUCTURE_TYPE_IMAGE_PLANE_MEMORY_REQUIREMENTS_INFO,
+      .pNext = NULL,
+      .planeAspect = pInfo->planeAspect,
+   };
    const VkImageMemoryRequirementsInfo2 info = {
       .sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_REQUIREMENTS_INFO_2,
-      .pNext = NULL,
+      .pNext = pInfo->planeAspect != VK_IMAGE_ASPECT_NONE ? &plane_info : NULL,
       .image = image,
    };
    dzn_GetImageMemoryRequirements2(dev, &info, pMemoryRequirements);
diff --git a/src/microsoft/vulkan/dzn_private.h b/src/microsoft/vulkan/dzn_private.h
index 3ac6696..cf5464a 100644
--- a/src/microsoft/vulkan/dzn_private.h
+++ b/src/microsoft/vulkan/dzn_private.h
@@ -871,6 +871,7 @@ struct dzn_descriptor_update_template_entry {
 
 struct dzn_descriptor_update_template {
    struct vk_object_base base;
+   VkPipelineBindPoint pipelineBindPoint;
    uint32_t entry_count;
    const struct dzn_descriptor_update_template_entry *entries;
 };
