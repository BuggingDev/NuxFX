From 3e38f11d047d3028a13c2b189a2f18a7334caa1a Mon Sep 17 00:00:00 2001
From: aegnux-contributor <contributor@example.invalid>
Date: Sun, 18 Oct 2026 05:04:54 +0300
Subject: [PATCH 04/18] dzn: report apiVersion 1.3 to the loader (workaround)

WORKAROUND. dzn reports Vulkan 1.3. An application that asks for a lower
apiVersion (DXVK asks for 1.0) gets NULL device entrypoints from the loader,
because the loader gates them on the instance's apiVersion. The instance's
app_info.api_version is therefore raised to 1.3 when the application asks for
less, and a line is printed to stderr when that happens. Remove this when the
applications or the wrapper layer request the right version.
---
 src/microsoft/vulkan/dzn_device.c | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/src/microsoft/vulkan/dzn_device.c b/src/microsoft/vulkan/dzn_device.c
index 96d1433..e7aee24 100644
--- a/src/microsoft/vulkan/dzn_device.c
+++ b/src/microsoft/vulkan/dzn_device.c
@@ -61,7 +61,7 @@
 
 #include <directx/d3d12sdklayers.h>
 
-#define DZN_API_VERSION VK_MAKE_VERSION(1, 2, VK_HEADER_VERSION)
+#define DZN_API_VERSION VK_MAKE_VERSION(1, 3, VK_HEADER_VERSION)
 
 #define MAX_TIER2_MEMORY_TYPES 4
 
@@ -1797,6 +1797,17 @@ dzn_instance_create(const VkInstanceCreateInfo *pCreateInfo,
       return result;
    }
 
+   /* dzn reports Vulkan 1.3 on its physical devices, and apps such as DXVK
+    * call 1.3 core entry points based on that. Vulkan gates device proc
+    * addresses on the instance's app apiVersion, so an app that requests
+    * a lower version gets NULL for them. Gate at 1.3 instead. */
+   if (instance->vk.app_info.api_version < VK_API_VERSION_1_3) {
+      fprintf(stderr, "dzn: app apiVersion %u.%u, gating device entrypoints at 1.3\n",
+              VK_VERSION_MAJOR(instance->vk.app_info.api_version),
+              VK_VERSION_MINOR(instance->vk.app_info.api_version));
+      instance->vk.app_info.api_version = VK_API_VERSION_1_3;
+   }
+
    instance->vk.physical_devices.enumerate = dzn_enumerate_physical_devices;
    instance->vk.physical_devices.destroy = dzn_physical_device_destroy;
    instance->debug_flags =
